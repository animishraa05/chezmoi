#!/usr/bin/env bash

# Tmux Sessionizer - Quickly jump between projects in Tmux using FZF
# Usage:
# Run `tmux-sessionizer` to select a project via fzf.
# It will either create a new tmux session named after the folder, or attach to the existing one.

if [[ $# -eq 1 ]]; then
    selected=$1
else
    # Use fd to instantly find all Git repositories up to 4 levels deep, plus some common config dirs
    git_repos=$(fd -H -I -t d '^\\.git$' ~ --max-depth 4 -E '.cache' -E '.local' -E '.cargo' -E '.rustup' -E '.npm' -E '.steam' -E '.var' -E 'Downloads' -x dirname {})
    config_dirs=$(find ~/.config -mindepth 1 -maxdepth 1 -type d)
    selected=$(printf "%s\n%s\n%s\n" "$git_repos" "$config_dirs" "$HOME" | sort -u | fzf)
fi

if [[ -z $selected ]]; then
    exit 0
fi

# Sanitize the folder name to be a valid tmux session name
selected_name=$(basename "$selected" | tr . _)
tmux_running=$(pgrep tmux)

# If tmux is not running at all, start it and attach to the new session
if [[ -z $TMUX ]] && [[ -z $tmux_running ]]; then
    tmux new-session -s $selected_name -c $selected
    exit 0
fi

# If the session doesn't exist yet, create it in the background
if ! tmux has-session -t=$selected_name 2> /dev/null; then
    tmux new-session -ds $selected_name -c $selected
fi

# Switch to the session (different command depending on if we are already INSIDE tmux)
if [[ -z $TMUX ]]; then
    tmux attach-session -t $selected_name
else
    tmux switch-client -t $selected_name
fi
