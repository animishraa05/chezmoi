/* Base Rofi Theme - Evergreen Pine */
/* Floating top-panel with left-accent selection */

* {
    /* Colors - Monochrome Black & White */
    bg:         #000000;
    bg-alt:     #111111;
    fg:         #ffffff;
    fg-alt:     #888888;
    accent:     #ffffff;
    selected:   #222222;
    border:     #444444;

    /* Typography - Bold & Readable */
    font: "JetBrainsMono Nerd Font Mono 14";
    font-bold: "JetBrainsMono Nerd Font Mono Bold 14";
}

/* Window - Top Spotlight */
window {
    location: center;
    anchor: center;
    fullscreen: false;
    width: 25%;
    x-offset: 0;
    y-offset: 0;
    border-radius: 0px;
    background-color: @bg;
    border: 4px;
    border-color: @fg;
}

/* Main Container */
mainbox {
    enabled: true;
    orientation: vertical;
    background-color: transparent;
    children: [inputbar, listview];
    spacing: 0;
}

/* Search Bar */
inputbar {
    enabled: true;
    orientation: horizontal;
    background-color: transparent;
    padding: 22px 24px 10px 24px;
    children: [prompt, entry];
    spacing: 14px;
}

prompt {
    enabled: false;
    background-color: @bg-alt;
    padding: 10px 18px;
    border-radius: 0px;
    text-color: @accent;
    font: @font-bold;
}

entry {
    enabled: true;
    background-color: @bg-alt;
    padding: 10px 18px;
    border-radius: 0px;
    text-color: @fg;
    font: "JetBrainsMono Nerd Font Mono 15";
    placeholder: "";
    placeholder-color: @fg-alt;
    cursor: "text";
}

/* List View */
listview {
    enabled: true;
    background-color: transparent;
    padding: 6px 20px 18px 20px;
    columns: 1;
    lines: 5;
    fixed-height: false;
    dynamic: true;
    scrollbar: false;
    spacing: 4px;
    layout: vertical;
    reverse: false;
    cycle: true;
    flow: vertical;
}

/* List Items */
element {
    enabled: true;
    padding: 10px 18px;
    border-radius: 0px;
    spacing: 14px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    font: @font;
    horizontal-align: 0.0;
    vertical-align: 0.5;
}

element-icon {
    background-color: transparent;
    size: 0px;
    horizontal-align: 0.5;
    vertical-align: 0.5;
}

/* Element States */
element normal.normal {
    background-color: transparent;
    text-color: @fg;
}

element normal.urgent {
    background-color: transparent;
    text-color: #aaaaaa;
}

element normal.active {
    background-color: transparent;
    text-color: #ffffff;
}

element selected.normal {
    background-color: @fg;
    text-color: @bg;
    border: 0;
}

element selected.urgent {
    background-color: @fg;
    text-color: @bg;
    border: 0;
}

element selected.active {
    background-color: @fg;
    text-color: @bg;
    border: 0;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}

/* Message/Textbox (for dialogs) */
message {
    background-color: transparent;
    padding: 0;
}

textbox {
    background-color: transparent;
    padding: 14px 24px;
    text-color: @fg;
    font: @font;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}

/* Scrollbar (hidden) */
scrollbar {
    enabled: false;
    handle-width: 4px;
    handle-color: @fg-alt;
}

/* Mode Switcher (tabs) */
mode-switcher {
    enabled: false;
    spacing: 0;
    padding: 0;
    background-color: transparent;
}

button {
    background-color: transparent;
    text-color: @fg;
    padding: 10px 14px;
    border-radius: 10px;
    font: @font;
}

button selected.normal {
    background-color: @selected;
    text-color: #ffffff;
}
