[
  {
    "label": "Java: Run Current File",
    "command": "mkdir -p /tmp/zed-java && javac -d /tmp/zed-java \"$ZED_FILE\" && package=$(sed -n 's/^[[:space:]]*package[[:space:]]\\+\\([^;]*\\);.*/\\1/p' \"$ZED_FILE\" | head -n 1) && if [ -n \"$package\" ]; then java -cp /tmp/zed-java \"$package.$ZED_STEM\"; else java -cp /tmp/zed-java \"$ZED_STEM\"; fi",
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "save": "current",
    "reevaluate_context": true
  },

  {
    "label": "Java: Compile Current File",
    "command": "mkdir -p /tmp/zed-java && javac -Xdiags:verbose -Xlint:all -d /tmp/zed-java \"$ZED_FILE\"",
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "save": "current",
    "reevaluate_context": true
  },

  {
    "label": "Java: Run Current File (Detailed Errors)",
    "command": "mkdir -p /tmp/zed-java && javac -Xdiags:verbose -d /tmp/zed-java \"$ZED_FILE\" && package=$(sed -n 's/^[[:space:]]*package[[:space:]]\\+\\([^;]*\\);.*/\\1/p' \"$ZED_FILE\" | head -n 1) && if [ -n \"$package\" ]; then java -cp /tmp/zed-java \"$package.$ZED_STEM\"; else java -cp /tmp/zed-java \"$ZED_STEM\"; fi",
    "cwd": "$ZED_DIRNAME",
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "save": "current",
    "reevaluate_context": true
  },

  {
    "label": "Java: Clean Temporary Build",
    "command": "rm -rf /tmp/zed-java",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },

