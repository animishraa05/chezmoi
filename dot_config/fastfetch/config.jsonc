{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/vagabond.txt",
    "color": {
      "1": "white"
    },
    "padding": {
      "top": 2,
      "left": 4,
      "right": 6
    }
  },
  "display": {
    "separator": " 󰁔 ",
    "color": {
      "keys": "white"
    }
  },
  "modules": [
    "break",
    {
      "type": "title",
      "color": {
        "user": "white",
        "at": "white",
        "host": "white"
      }
    },
    "break",
    {
      "type": "os",
      "key": "OS",
      "format": "{2}"
    },
    {
      "type": "kernel",
      "key": "Kernel"
    },
    {
      "type": "uptime",
      "key": "Uptime"
    },
    {
      "type": "packages",
      "key": "Packages"
    },
    {
      "type": "wm",
      "key": "WM"
    },
    {
      "type": "terminal",
      "key": "Terminal"
    },
    {
      "type": "memory",
      "key": "Memory"
    },
    "break"
  ]
}
