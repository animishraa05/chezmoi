# qutebrowser: nested git repo - tracked in animishraa05/qutebrowser-config
.config/qutebrowser/.git/**
.config/qutebrowser/.env
**/__pycache__/**

# Repo documentation, not a file to deploy into $HOME.
# Without this, chezmoi treats it as a target and wants to write ~/README.md
README.md

# oil.nvim's symlink farm: "oil:" plus colons in the path confuse
# chezmoi's dot-prefix parsing and produce a bogus source tree.
.config/nvim/oil:*
**/oil:/**
